  "q112_output_match_caveat": {
    "question": "Among musical-instrument brands that sell at least fifty different products in the catalog, which brand has the highest average list price in dollars? If two brands tie, choose the one whose name sorts first alphabetically.",
    "reference": "SELECT attr_val FROM (\n                    SELECT a.attr_val, AVG(i.prc) AS ap\n                    FROM product_attributes_g3 a\n                    JOIN items_g3 i ON a.ref_id = i.ref_id\n                    WHERE a.attr_key = 'Brand'\n                    AND i.prc IS NOT NULL AND i.prc > 0\n                    GROUP BY a.attr_val\n                    HAVING COUNT(DISTINCT a.ref_id) >= 50\n                    ORDER BY ap DESC, a.attr_val ASC\n                    LIMIT 1\n                )",
    "reference_result": [
      [
        "Fender"
      ]
    ],
    "stale1": {
      "query": "SELECT attr_val FROM attributes WHERE category='musical instruments' AND attr_key='Brand' GROUP BY attr_val HAVING COUNT(DISTINCT ref_id)>=50 ORDER BY COUNT(DISTINCT ref_id) DESC, attr_val ASC LIMIT 1",
      "result": [
        [
          "Fender"
        ]
      ]
    },
    "adapter1-228": {
      "query": "SELECT a.attr_val FROM attributes a JOIN products p USING(category,ref_id) WHERE a.category='musical instruments' AND a.attr_key='Brand' GROUP BY a.attr_val HAVING COUNT(DISTINCT a.ref_id)>=50 ORDER BY AVG(p.price) DESC, a.attr_val ASC LIMIT 1",
      "result": [
        [
          "Yamaha"
        ]
      ]
    },
    "updated_query_with_reference_positive_price_filter": {
      "query": "SELECT a.attr_val FROM attributes a JOIN products p USING(category,ref_id) WHERE a.category='musical instruments' AND a.attr_key='Brand' AND p.price > 0 GROUP BY a.attr_val HAVING COUNT(DISTINCT a.ref_id)>=50 ORDER BY AVG(p.price) DESC, a.attr_val ASC LIMIT 1",
      "result": [
        [
          "Fender"
        ]
      ]
    }
